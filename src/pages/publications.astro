---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import { publications } from '../data/publications';
import { profile } from '../data/profile';
const years = [...new Set(publications.map((paper) => paper.year))].sort((a, b) => b - a);
---
<BaseLayout title="Publications">
  <header class="page-header"><h1>Publications</h1><div class="page-actions"><a class="text-link" href={profile.links.scholar}>Google Scholar ↗</a></div></header>
  {years.map((year) => <section class="publication-year"><h2>{year}</h2><PublicationList items={publications.filter((paper) => paper.year === year)} /></section>)}
</BaseLayout>
